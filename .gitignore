# External pinned source checkouts under the LTD umbrella (never vendor into Git)
/.vendor/

# Python
__pycache__/
*.pyc
.venv/
venv/

# ML
*.pth
*.pt
*.ckpt
*.joblib

# Data
*.pcap
*.pcapng

# Large generated datasets
output/
results/
checkpoints/

# Local datasets (manifests and documentation remain trackable)
data/local/*
!data/local/
!data/local/manifests/
!data/local/manifests/README.md

# macOS
.DS_Store

# Secrets
credentials*.json
.env
.env.*
secrets/

# Ephemeral developer and experiment files (NOT scientific evidence)
*.log
*.tmp
*.temp
*.swp
*.swo
*.bak
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.coverage
coverage.xml

# Large generated intermediate arrays: keep on ltd-storage, not in Git
*.npy
*.npz
